load("@bazel_skylib//rules:build_test.bzl", "build_test")
load("@aspect_rules_js//js:defs.bzl", "js_test")
load("@rules_zig//zig:defs.bzl", "zig_binary", "zig_configure_binary")
load("//bazel:cc.bzl", "cc_headers", "cc_object_archive", "zig_cxx_object")
load("//luau:components.bzl", "luauc_c_archive", "luauc_cpp_archive")

cc_headers(
    name = "frontend_incs",
    hdrs = [],
    includes = ["."],
    visibility = ["//visibility:public"],
)

filegroup(
    name = "compiler_build_digest_inputs",
    srcs = ["frontend_adapter.cpp"],
    visibility = ["//visibility:public"],
)

filegroup(
    name = "compiler_patch_headers",
    srcs = [
        "compiler_error_channel.h",
        "error_channel.h",
        "trap.h",
    ],
    visibility = ["//visibility:public"],
)

filegroup(
    name = "frontend_contract_inputs",
    srcs = [
        "BUILD.bazel",
        "compiler_error_channel.h",
        "error_channel.h",
        "frontend_adapter.cpp",
        "frontend_fastflags.cpp",
        "frontend_host.zig",
        "host_wasi_stubs.c",
        "trap.h",
    ],
)

luauc_cpp_archive(
    name = "adapter_wasm32_wasi",
    srcs = [
        "frontend_adapter.cpp",
        "frontend_fastflags.cpp",
    ],
    copts = [
        "-DLUAUC_COMPILER_HOST=1",
        "-fno-exceptions",
        "-fno-math-errno",
        "-fno-rtti",
    ],
    extra_srcs = [
        "@luau//:interp_all_hdrs",
        "@luau//:aot_frontend_codegen_ir_headers",
        "//schema:frontend_snapshot_v1.h",
        ":compiler_patch_headers",
        "frontend_identity_v1.h",
    ],
    deps = [
        ":frontend_incs",
        "@luau//:aot_frontend_codegen_ir_incs",
        "@luau//:interp_incs",
    ],
    visibility = ["//visibility:public"],
)

zig_cxx_object(
    name = "luau_execute_stub_object",
    src = "luau_execute_stub.cpp",
    target = "wasm32-wasi",
    copts = [
        "-Oz",
        "-DNDEBUG",
        "-std=c++17",
        "-fno-exceptions",
        "-fno-rtti",
    ],
    extra_srcs = [
        "@luau//:interp_all_hdrs",
        ":compiler_patch_headers",
    ],
    deps = [
        ":frontend_incs",
        "@luau//:interp_incs",
    ],
)

cc_object_archive(
    name = "luau_execute_stub_wasm32_wasi",
    objects = [":luau_execute_stub_object"],
    deps = [
        ":frontend_incs",
        "@luau//:interp_incs",
    ],
    visibility = ["//visibility:public"],
)

luauc_c_archive(
    name = "host_stubs_wasm32_wasi",
    srcs = ["host_wasi_stubs.c"],
    copts = ["-fno-math-errno"],
    extra_srcs = [],
    deps = [],
    visibility = ["//visibility:public"],
)

# This is an optional host capability, not a target guest. It may contain the source compiler,
# temporary bytecode loader needed to materialize a Proto; none of those TUs are in //runtime and
# no guest bytecode is executed. The only product boundary exported from C++ is one owned
# FrontendSnapshotV1 byte buffer.
zig_binary(
    name = "frontend_raw",
    srcs = ["frontend_host.zig"],
    linkopts = [
        "-lc",
        "-lc++",
        "-fno-entry",
        "--initial-memory=67108864",
        "--max-memory=536870912",
        "--export=luauc_frontend_v1_init",
        "--export=luauc_frontend_v1_alloc",
        "--export=luauc_frontend_v1_dealloc",
        "--export=luauc_frontend_v1_validate_snapshot",
        "--export=luauc_frontend_snapshot_v1_compile",
        "--export=luauc_frontend_snapshot_v1_compile_inlined",
        "--export=luauc_frontend_snapshot_v1_free",
        "--export=luauc_frontend_snapshot_v1_last_raise_message",
        "--export=luauc_frontend_snapshot_v1_last_raise_message_size",
    ],
    main = "frontend_host.zig",
    tags = ["manual"],
    deps = [
        ":adapter_wasm32_wasi",
        ":frontend_incs",
        ":host_stubs_wasm32_wasi",
        ":luau_execute_stub_wasm32_wasi",
        "@luau//:aot_frontend_wasm32_wasi",
        "@luau//:aot_frontend_codegen_ir_incs",
        "@luau//:interp_incs",
        "//compiler/ir:frontend_snapshot_v1",
    ],
)

zig_configure_binary(
    name = "frontend_wasm",
    actual = ":frontend_raw",
    mode = "release_small",
    tags = ["manual"],
    target = "//platforms:wasm32_wasi",
    threaded = "single",
    visibility = ["//visibility:public"],
)

build_test(
    name = "frontend_build_test",
    targets = [":frontend_wasm"],
)

js_test(
    name = "frontend_snapshot_test",
    data = [
        ":frontend_snapshot.test.mjs",
        ":frontend_contract_inputs",
        ":frontend_wasm",
        "//compiler/ir:frontend_contract_inputs",
        "//conformance/maps:frontend_identity_inputs",
        "//schema:frontend_contract_inputs",
        "//third_party/luau:frontend_contract_inputs",
    ],
    entry_point = "frontend_snapshot.test.mjs",
    env = {
        "LUAUC_FRONTEND_WASM": "$(rlocationpath :frontend_wasm)",
    },
)
