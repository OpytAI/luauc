js_test(
    name = "runtime_archive_test",
    data = [
        "//conformance/maps:runtime_objects_json",
        "//conformance/maps:runtime_sources_json",
        "//runtime:runtime_archive_wasm32",
        "runtime_archive.test.mjs",
    ],
    entry_point = "runtime_archive.test.mjs",
    env = {
        "LUAUC_RUNTIME_ARCHIVE": "$(rlocationpath //runtime:runtime_archive_wasm32)",
        "LUAUC_RUNTIME_OBJECT_MANIFEST": "$(rlocationpath //conformance/maps:runtime_objects_json)",
        "LUAUC_RUNTIME_SOURCE_MANIFEST": "$(rlocationpath //conformance/maps:runtime_sources_json)",
    },
)
