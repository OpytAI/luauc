load("@aspect_rules_js//js:defs.bzl", "js_library", "js_test")
load("@bazel_skylib//rules:build_test.bzl", "build_test")
load("@rules_zig//zig:defs.bzl", "zig_binary", "zig_configure_binary")

exports_files([
    "generate_artifact_report.mjs",
    "generate_link_conformance.mjs",
    "generate_runtime_profile.mjs",
    "generate_runtime_symbols.mjs",
    "generate_wasm_features.mjs",
    "ir_ledger.mjs",
    "wasm_bytes.mjs",
])

js_library(
    name = "wasm_bytes",
    srcs = ["wasm_bytes.mjs"],
    visibility = ["//visibility:public"],
)

js_library(
    name = "ir_ledger",
    srcs = ["ir_ledger.mjs"],
    visibility = ["//visibility:public"],
)

js_library(
    name = "generate_link_conformance",
    srcs = ["generate_link_conformance.mjs"],
    deps = [":wasm_bytes"],
    visibility = ["//visibility:public"],
)

zig_binary(
    name = "layout_probe_raw",
    copts = [
        "-fno-exceptions",
        "-fno-rtti",
    ],
    csrcs = ["layout_probe.cpp"],
    extra_srcs = [
        "@luau//:interp_all_hdrs",
        "layout_fields.def",
    ],
    linkopts = [
        "-lc",
        "-fno-entry",
        "--export=luauc_layout_schema_version",
        "--export=luauc_layout_value_count",
        "--export=luauc_layout_value",
    ],
    main = "layout_probe_root.zig",
    tags = ["manual"],
    deps = ["@luau//:interp_incs"],
)
zig_configure_binary(
    name = "layout_probe_wasm",
    actual = ":layout_probe_raw",
    mode = "release_small",
    target = "//platforms:wasm32_wasi",
    threaded = "single",
)

build_test(
    name = "layout_probe_build_test",
    targets = [":layout_probe_wasm"],
)

js_test(
    name = "layout_manifest_test",
    data = [
        "//conformance/maps:layout_json",
        ":layout_probe_wasm",
        "layout_fields.def",
        "layout_probe.test.mjs",
    ],
    entry_point = "layout_probe.test.mjs",
    env = {
        "LUAUC_LAYOUT_FIELDS": "$(rlocationpath layout_fields.def)",
        "LUAUC_LAYOUT_MANIFEST": "$(rlocationpath //conformance/maps:layout_json)",
        "LUAUC_LAYOUT_WASM": "$(rlocationpath :layout_probe_wasm)",
    },
)

js_test(
    name = "ir_coverage_test",
    size = "large",
    data = [
        "generate_general_arms.mjs",
        "generate_ir_coverage.mjs",
        "ir_coverage.test.mjs",
        "ir_ledger.mjs",
        "//compiler/backend:backend_wasm",
        "//conformance/sources:ir_ledger_luau",
        "//compiler/backend/emit:dispatch_zig",
        "//conformance/maps:bazel_label_allowlist_json",
        "//conformance/maps:general_arms_fixture_json",
        "//conformance/maps:general_arms_json",
        "//conformance/maps:ir_command_forms_json",
        "//conformance/maps:ir_coverage_json",
        "//conformance/maps:ir_ledger_corpus_json",
        "//conformance/sources:embed_lib",
        "//conformance/sources:embed_main",
        "//conformance/sources:proto_identity",
        "//conformance/sources:userdata_hooks",
        "//frontend:frontend_wasm",
    ],
    entry_point = "ir_coverage.test.mjs",
    env = {
        "LUAUC_BACKEND_WASM": "$(rlocationpath //compiler/backend:backend_wasm)",
        "LUAUC_BAZEL_LABEL_ALLOWLIST": "$(rlocationpath //conformance/maps:bazel_label_allowlist_json)",
        "LUAUC_DISPATCH_ZIG": "$(rlocationpath //compiler/backend/emit:dispatch_zig)",
        "LUAUC_FRONTEND_WASM": "$(rlocationpath //frontend:frontend_wasm)",
        "LUAUC_GENERAL_ARMS": "$(rlocationpath //conformance/maps:general_arms_json)",
        "LUAUC_GENERAL_ARMS_FIXTURE": "$(rlocationpath //conformance/maps:general_arms_fixture_json)",
        "LUAUC_IR_COMMAND_FORMS": "$(rlocationpath //conformance/maps:ir_command_forms_json)",
        "LUAUC_IR_COVERAGE": "$(rlocationpath //conformance/maps:ir_coverage_json)",
        "LUAUC_IR_LEDGER_CORPUS": "$(rlocationpath //conformance/maps:ir_ledger_corpus_json)",
    },
)

js_test(
    name = "forbidden_link_test",
    data = [
        "forbidden_link.test.mjs",
        "//conformance/maps:forbidden_link_json",
        "//frontend:luau_execute_stub_wasm32_wasi",
        "//runtime:runtime_archive_wasm32",
        "@luau//:aot_frontend_interp_wasm32_wasi",
    ],
    entry_point = "forbidden_link.test.mjs",
    env = {
        "LUAUC_EXECUTE_STUB_OBJECT": "$(rlocationpath //frontend:luau_execute_stub_wasm32_wasi)",
        "LUAUC_FORBIDDEN_LINK": "$(rlocationpath //conformance/maps:forbidden_link_json)",
        "LUAUC_FRONTEND_INTERP_ARCHIVE": "$(rlocationpath @luau//:aot_frontend_interp_wasm32_wasi)",
        "LUAUC_RUNTIME_ARCHIVE": "$(rlocationpath //runtime:runtime_archive_wasm32)",
    },
)

