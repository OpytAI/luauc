load("@bazel_skylib//rules:build_test.bzl", "build_test")
load("@aspect_rules_js//js:defs.bzl", "js_test")
load("@rules_zig//zig:defs.bzl", "zig_binary", "zig_library", "zig_test")

exports_files(["object.zig"])

zig_library(
    name = "object",
    import_name = "luauc_wasm_object",
    main = "object.zig",
    visibility = ["//visibility:public"],
)

zig_test(
    name = "object_test",
    main = "object.zig",
)

zig_test(
    name = "scalar_fixture_test",
    main = "scalar_fixture.zig",
    srcs = ["object.zig"],
)

zig_binary(
    name = "scalar_fixture_emitter",
    main = "scalar_fixture_main.zig",
    srcs = [
        "object.zig",
        "scalar_fixture.zig",
    ],
)

genrule(
    name = "scalar_fixture_object",
    outs = ["scalar_fixture.o"],
    cmd = "$(execpath :scalar_fixture_emitter) > $@",
    tools = [":scalar_fixture_emitter"],
    visibility = ["//visibility:public"],
)

build_test(
    name = "scalar_fixture_object_build_test",
    targets = [":scalar_fixture_object"],
)

genrule(
    name = "scalar_fixture_wasm_ld_reference",
    srcs = [":scalar_fixture_object"],
    outs = ["scalar_fixture_wasm_ld_reference.wasm"],
    cmd = "$(execpath @@emsdk++emscripten_deps+emscripten_bin_linux//:bin/wasm-ld) --no-entry --allow-undefined --export-memory --export=luauc_runtime_v1_generated_scalar_fixture $(location :scalar_fixture_object) -o $@",
    tools = ["@@emsdk++emscripten_deps+emscripten_bin_linux//:bin/wasm-ld"],
    visibility = ["//visibility:public"],
)

js_test(
    name = "scalar_fixture_wasm_ld_reference_test",
    data = [
        ":scalar_fixture.test.mjs",
        ":scalar_fixture_wasm_ld_reference",
    ],
    entry_point = "scalar_fixture.test.mjs",
    env = {
        "LUAUC_SCALAR_FIXTURE_WASM": "$(rlocationpath :scalar_fixture_wasm_ld_reference)",
    },
)
