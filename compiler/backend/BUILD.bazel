load("@bazel_skylib//rules:build_test.bzl", "build_test")
load("@aspect_rules_js//js:defs.bzl", "js_library", "js_test")
load("@rules_zig//zig:defs.bzl", "zig_binary", "zig_configure_binary", "zig_library", "zig_static_library")

exports_files(
    glob(["*.luau"]),
    visibility = ["//visibility:public"],
)

js_library(
    name = "ir_ledger_luau",
    srcs = [
        "buffer_scalar_matrix.luau",
        "captured_call.luau",
        "compiled_call.luau",
        "dynamic_array_table.luau",
        "dynamic_hash_table.luau",
        "dynamic_string.luau",
        "fast_builtins.luau",
        "forwarded_capture.luau",
        "generic_iteration.luau",
        "generic_table.luau",
        "global_state.luau",
        "mixed_table.luau",
        "multi_result_call.luau",
        "reference_capture.luau",
        "recursive_call.luau",
        "silent_return.luau",
        "slow_add.luau",
        "table_clone_append.luau",
        "table_namecall.luau",
        "yield_call.luau",
    ],
    visibility = ["//visibility:public"],
)

zig_library(
    name = "runtime_abi",
    main = "runtime_abi.zig",
    import_name = "luauc_backend_runtime_abi",
    visibility = ["//compiler/backend:__subpackages__"],
    deps = ["//compiler/ir:frontend_snapshot_v1"],
)

zig_library(
    name = "static_package_v1",
    main = "static_package_v1.zig",
    import_name = "luauc_backend_static_package_v1",
)

zig_library(
    name = "model",
    main = "model.zig",
    import_name = "luauc_backend_model",
    visibility = ["//compiler/backend:__subpackages__"],
    deps = [
        ":runtime_abi",
        ":static_package_v1",
        "//compiler/ir:frontend_snapshot_v1",
        "//compiler/wasm:object",
    ],
)

zig_library(
    name = "recognize",
    main = "recognize.zig",
    import_name = "luauc_backend_recognize",
    visibility = ["//compiler/backend:__subpackages__"],
    deps = [
        ":model",
        ":runtime_abi",
        "//compiler/ir:frontend_snapshot_v1",
    ],
)

zig_library(
    name = "plan",
    main = "plan.zig",
    import_name = "luauc_backend_plan",
    visibility = ["//compiler/backend:__subpackages__"],
    deps = [
        ":model",
        ":recognize",
        ":runtime_abi",
        "//compiler/ir:frontend_snapshot_v1",
    ],
)

zig_library(
    name = "diagnostics",
    main = "diagnostics.zig",
    import_name = "luauc_backend_diagnostics",
    visibility = ["//compiler/backend:__subpackages__"],
)

zig_library(
    name = "context",
    main = "context.zig",
    import_name = "luauc_backend_context",
    deps = [
        "//compiler/backend/emit:allocations",
        "//compiler/backend/emit:builtin_patterns",
        "//compiler/backend/emit:calls",
        "//compiler/backend/emit:closures",
        "//compiler/backend/emit:control",
        "//compiler/backend/emit:core",
        "//compiler/backend/emit:dispatch",
        "//compiler/backend/emit:iteration",
        "//compiler/backend/emit:memory",
        "//compiler/backend/emit:namecall",
        "//compiler/backend/emit:operators",
        "//compiler/backend/emit:scalar",
        "//compiler/backend/emit:tables",
        "//compiler/backend/emit:table_values",
        ":model",
        ":diagnostics",
        ":plan",
        ":static_package_v1",
        "//compiler/ir:frontend_snapshot_v1",
        "//compiler/wasm:object",
    ],
)

zig_library(
    name = "continuations",
    main = "continuations.zig",
    import_name = "luauc_backend_continuations",
    deps = [
        ":context",
        ":diagnostics",
        ":model",
        ":plan",
        ":runtime_abi",
        "//compiler/ir:frontend_snapshot_v1",
    ],
)

zig_library(
    name = "imports",
    main = "imports.zig",
    import_name = "luauc_backend_imports",
    visibility = ["//compiler/backend:__subpackages__"],
    deps = [
        ":model",
        ":runtime_abi",
        "//compiler/ir:frontend_snapshot_v1",
        "//compiler/wasm:object",
    ],
)

zig_library(
    name = "driver",
    main = "driver.zig",
    import_name = "luauc_backend_driver",
    deps = [
        ":context",
        ":continuations",
        ":diagnostics",
        ":imports",
        ":model",
        ":plan",
        ":runtime_abi",
        ":static_package_v1",
        "//compiler/ir:frontend_snapshot_v1",
        "//compiler/wasm:object",
    ],
)

zig_library(
    name = "backend",
    main = "lower.zig",
    import_name = "luauc_backend",
    visibility = ["//visibility:public"],
    deps = [
        ":driver",
        ":diagnostics",
        ":model",
        ":runtime_abi",
    ],
)

zig_library(
    name = "component_api",
    main = "component_api.zig",
    import_name = "luauc_backend_component_api",
    visibility = ["//visibility:public"],
)

zig_static_library(
    name = "component",
    main = "component.zig",
    tags = ["manual"],
    deps = [
        ":backend",
        ":component_api",
    ],
    visibility = ["//visibility:public"],
)

zig_binary(
    name = "backend_raw",
    srcs = ["backend_host.zig"],
    linkopts = [
        "-fno-entry",
        "--initial-memory=33554432",
        "--max-memory=268435456",
        "--export=luauc_backend_v1_alloc",
        "--export=luauc_backend_v1_compile",
        "--export=luauc_backend_v1_compile_package",
        "--export=luauc_backend_v1_compile_static_package",
        "--export=luauc_backend_v1_dealloc",
        "--export=luauc_backend_v1_free",
    ],
    main = "backend_host.zig",
    tags = ["manual"],
    deps = [
        ":component",
        ":component_api",
    ],
)

zig_configure_binary(
    name = "backend_wasm",
    actual = ":backend_raw",
    mode = "release_small",
    target = "//platforms:wasm32_wasi",
    threaded = "single",
    visibility = ["//visibility:public"],
)

build_test(
    name = "backend_build_test",
    targets = [":backend_wasm"],
)

js_test(
    name = "frontend_to_wasm_test",
    data = [
        ":backend_wasm",
        ":frontend_to_wasm.test.mjs",
        "buffer_scalar_matrix.luau",
        "captured_call.luau",
        "compiled_call.luau",
        "dynamic_array_table.luau",
        "dynamic_hash_table.luau",
        "dynamic_string.luau",
        "fast_builtins.luau",
        "forwarded_capture.luau",
        "generic_iteration.luau",
        "generic_table.luau",
        "global_state.luau",
        "mixed_table.luau",
        "multi_result_call.luau",
        "reference_capture.luau",
        "recursive_call.luau",
        "silent_return.luau",
        "slow_add.luau",
        "table_clone_append.luau",
        "table_namecall.luau",
        "yield_call.luau",
        "//conformance/sources:embed_lib",
        "//conformance/sources:proto_identity",
        "//conformance/sources:userdata_hooks",
        "//frontend:frontend_wasm",
        "@@emsdk++emscripten_deps+emscripten_bin_linux//:bin/wasm-ld",
    ],
    entry_point = "frontend_to_wasm.test.mjs",
    env = {
        "LUAUC_BACKEND_WASM": "$(rlocationpath :backend_wasm)",
        "LUAUC_BUFFER_SCALAR_MATRIX_SOURCE": "$(rlocationpath buffer_scalar_matrix.luau)",
        "LUAUC_CAPTURED_CALL_SOURCE": "$(rlocationpath captured_call.luau)",
        "LUAUC_COMPILED_CALL_SOURCE": "$(rlocationpath compiled_call.luau)",
        "LUAUC_DYNAMIC_ARRAY_TABLE_SOURCE": "$(rlocationpath dynamic_array_table.luau)",
        "LUAUC_DYNAMIC_HASH_TABLE_SOURCE": "$(rlocationpath dynamic_hash_table.luau)",
        "LUAUC_DYNAMIC_STRING_SOURCE": "$(rlocationpath dynamic_string.luau)",
        "LUAUC_EMBED_LIB_SOURCE": "$(rlocationpath //conformance/sources:embed_lib)",
        "LUAUC_PROTO_IDENTITY_SOURCE": "$(rlocationpath //conformance/sources:proto_identity)",
        "LUAUC_USERDATA_HOOKS_SOURCE": "$(rlocationpath //conformance/sources:userdata_hooks)",
        "LUAUC_FAST_BUILTINS_SOURCE": "$(rlocationpath fast_builtins.luau)",
        "LUAUC_FORWARDED_CAPTURE_SOURCE": "$(rlocationpath forwarded_capture.luau)",
        "LUAUC_FRONTEND_WASM": "$(rlocationpath //frontend:frontend_wasm)",
        "LUAUC_GENERIC_ITERATION_SOURCE": "$(rlocationpath generic_iteration.luau)",
        "LUAUC_GENERIC_TABLE_SOURCE": "$(rlocationpath generic_table.luau)",
        "LUAUC_GLOBAL_STATE_SOURCE": "$(rlocationpath global_state.luau)",
        "LUAUC_MIXED_TABLE_SOURCE": "$(rlocationpath mixed_table.luau)",
        "LUAUC_MULTI_RESULT_CALL_SOURCE": "$(rlocationpath multi_result_call.luau)",
        "LUAUC_RECURSIVE_CALL_SOURCE": "$(rlocationpath recursive_call.luau)",
        "LUAUC_REFERENCE_CAPTURE_SOURCE": "$(rlocationpath reference_capture.luau)",
        "LUAUC_SILENT_SOURCE": "$(rlocationpath silent_return.luau)",
        "LUAUC_SLOW_ADD_SOURCE": "$(rlocationpath slow_add.luau)",
        "LUAUC_TABLE_CLONE_APPEND_SOURCE": "$(rlocationpath table_clone_append.luau)",
        "LUAUC_TABLE_NAMECALL_SOURCE": "$(rlocationpath table_namecall.luau)",
        "LUAUC_WASM_LD": "$(rlocationpath @@emsdk++emscripten_deps+emscripten_bin_linux//:bin/wasm-ld)",
        "LUAUC_YIELD_CALL_SOURCE": "$(rlocationpath yield_call.luau)",
    },
    no_copy_to_bin = ["@@emsdk++emscripten_deps+emscripten_bin_linux//:bin/wasm-ld"],
)
