load("@bazel_skylib//rules:build_test.bzl", "build_test")
load("@aspect_rules_js//js:defs.bzl", "js_binary", "js_library", "js_test")
load("@rules_zig//zig:defs.bzl", "zig_binary", "zig_configure", "zig_configure_binary", "zig_library", "zig_static_library", "zig_test")

js_library(
    name = "compiler_build_digest_json",
    srcs = ["compiler_build_digest.json"],
    visibility = ["//visibility:public"],
)

filegroup(
    name = "compiler_build_digest_inputs",
    srcs = [
        "compiler_host.zig",
        "compiler_entry.zig",
    ],
    visibility = ["//visibility:public"],
)

zig_static_library(
    name = "compiler_component",
    main = "compiler_host.zig",
    extra_srcs = ["compiler_build_digest.zig"],
    tags = ["manual"],
    deps = [
        "//compiler/backend:component_api",
        "//compiler/ir:frontend_snapshot_v1",
        "//compiler/link:linker",
        "//schema:compiler_result_v1",
        "//schema:runtime_profile_v1",
        "//schema:source_package_v1",
    ],
)

zig_configure(
    name = "compiler_component_wasm32_wasi",
    actual = ":compiler_component",
    mode = "release_small",
    target = "//platforms:wasm32_wasi",
    threaded = "single",
)

zig_binary(
    name = "compiler_raw",
    main = "compiler_entry.zig",
    linkopts = [
        "-lc",
        "-lc++",
        "-fno-entry",
        "--initial-memory=67108864",
        "--max-memory=536870912",
        "--export=luauc_v1_describe",
        "--export=luauc_v1_alloc",
        "--export=luauc_v1_dealloc",
        "--export=luauc_v1_context_create",
        "--export=luauc_v1_context_destroy",
        "--export=luauc_v1_compile",
        "--export=luauc_v1_result_free",
    ],
    tags = ["manual"],
    deps = [
        ":compiler_component_wasm32_wasi",
        "//compiler/backend:component",
        "//frontend:adapter_wasm32_wasi",
        "//frontend:host_stubs_wasm32_wasi",
        "//frontend:luau_execute_stub_wasm32_wasi",
        "@luau//:aot_frontend_wasm32_wasi",
    ],
)

zig_configure_binary(
    name = "compiler_wasm_unstripped",
    actual = ":compiler_raw",
    mode = "release_small",
    target = "//platforms:wasm32_wasi",
    threaded = "single",
)

js_binary(
    name = "strip_start",
    entry_point = "strip_start.mjs",
)

genrule(
    name = "compiler_wasm",
    srcs = [":compiler_wasm_unstripped"],
    outs = ["luauc.wasm"],
    cmd = "BAZEL_BINDIR=. $(execpath :strip_start) $(location :compiler_wasm_unstripped) $@",
    tools = [":strip_start"],
    visibility = ["//visibility:public"],
)

zig_test(
    name = "compiler_result_v1_layout_test",
    main = "compiler_result_v1_layout_test.zig",
    deps = ["//schema:compiler_result_v1"],
)

build_test(
    name = "compiler_build_test",
    targets = [":compiler_wasm"],
)

js_test(
    name = "compiler_api_test",
    data = [
        ":compiler_api.test.mjs",
        ":compiler_wasm",
        "//profiles/embed:embed_v1_profile",
        "//profiles/embed:embed_v1_pack",
        "//profiles/embed:embed_alt_v1_profile",
        "//profiles/embed:embed_alt_v1_pack",
    ],
    entry_point = "compiler_api.test.mjs",
    env = {
        "LUAUC_COMPILER_WASM": "$(rlocationpath :compiler_wasm)",
        "LUAUC_EMBED_PROFILE": "$(rlocationpath //profiles/embed:embed_v1_profile)",
        "LUAUC_EMBED_PACK": "$(rlocationpath //profiles/embed:embed_v1_pack)",
        "LUAUC_EMBED_ALT_PROFILE": "$(rlocationpath //profiles/embed:embed_alt_v1_profile)",
        "LUAUC_EMBED_ALT_PACK": "$(rlocationpath //profiles/embed:embed_alt_v1_pack)",
    },
)
