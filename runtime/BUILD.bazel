load("@aspect_rules_js//js:defs.bzl", "js_library")
load("@bazel_skylib//rules:build_test.bzl", "build_test")
load("@rules_zig//zig:defs.bzl", "zig_configure", "zig_library")
load("//bazel:cc.bzl", "cc_headers", "cc_object_archive", "zig_cxx_object")

exports_files([
    "runtime_symbols.bzl",
    "abi_v1.zig",
    "include/aot_runtime_v1.h",
])

js_library(
    name = "runtime_symbols_bzl",
    srcs = ["runtime_symbols.bzl"],
    visibility = ["//visibility:public"],
)

js_library(
    name = "aot_runtime_v1_h",
    srcs = ["include/aot_runtime_v1.h"],
    visibility = ["//visibility:public"],
)

cc_headers(
    name = "runtime_incs",
    hdrs = ["include/aot_runtime_v1.h"],
    includes = ["include"],
    visibility = ["//visibility:public"],
)

cc_headers(
    name = "runtime_patch_incs",
    hdrs = [],
    includes = ["include"],
    visibility = ["//visibility:public"],
)

# Plain files are separate from the include-only CcInfo so rules_zig consumers do not feed the C++
# patch headers to translate-c while still making them declared action inputs.
filegroup(
    name = "runtime_patch_headers",
    srcs = [
        "include/error_channel.h",
        "include/force_extern_c.h",
        "include/trap.h",
    ],
    visibility = ["//visibility:public"],
)

zig_library(
    name = "runtime_abi",
    import_name = "luauc_runtime_abi",
    main = "abi_v1.zig",
    visibility = ["//visibility:public"],
)

zig_cxx_object(
    name = "runtime_call_frame_object",
    src = "src/call_frame.cpp",
    target = "wasm32-wasi",
    copts = [
        "-Oz",
        "-DNDEBUG",
        "-std=c++17",
        "-DLUAUC_RUNTIME=1",
        "-include",
        "force_extern_c.h",
        "-fno-exceptions",
        "-fno-rtti",
    ],
    extra_srcs = [
        "@luau//:interp_all_hdrs",
        "include/aot_runtime_v1.h",
        "include/error_channel.h",
        "include/force_extern_c.h",
        "include/trap.h",
    ],
    deps = [
        ":runtime_incs",
        "@luau//:interp_incs",
    ],
)

cc_object_archive(
    name = "runtime_archive_raw",
    objects = [
        ":runtime_call_frame_object",
        "@luau//:aot_runtime_wasm32_wasi_objects",
    ],
    deps = [
        ":runtime_incs",
        "@luau//:interp_headers",
    ],
    visibility = ["//visibility:public"],
)

zig_configure(
    name = "runtime_archive_wasm32",
    actual = ":runtime_archive_raw",
    mode = "release_small",
    target = "//platforms:wasm32_wasi",
    threaded = "single",
    visibility = ["//visibility:public"],
)

build_test(
    name = "runtime_archive_build_test",
    targets = [":runtime_archive_wasm32"],
)
