common --enable_workspace=false
common --enable_runfiles
common --incompatible_strict_action_env
common --copt=-w
common --host_copt=-w

# luauc ships executable compiler and runtime hosts; optimized code is the default product build.
# Developers can still request --compilation_mode=dbg or fastbuild explicitly for diagnostics.
build --compilation_mode=opt
test --test_output=errors

# Machine-local output/cache placement belongs in this ignored file.
try-import %workspace%/user.bazelrc
