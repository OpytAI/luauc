+// True when this statement, or a statement nested inside it, defines a goto label.
+// The parser still treats return, break, and continue as last statements, so a label
+// after one of those never appears here. A label after a constant-folded return does.
+static bool opensGotoLabel(AstStat* node)
+{
+    if (node->is<AstStatLabel>())
+        return true;
+
+    if (AstStatBlock* stat = node->as<AstStatBlock>())
+    {
+        for (size_t i = 0; i < stat->body.size; ++i)
+            if (opensGotoLabel(stat->body.data[i]))
+                return true;
+
+        return false;
+    }
+
+    if (AstStatIf* stat = node->as<AstStatIf>())
+        return opensGotoLabel(stat->thenbody) || (stat->elsebody && opensGotoLabel(stat->elsebody));
+
+    if (AstStatWhile* stat = node->as<AstStatWhile>())
+        return opensGotoLabel(stat->body);
+
+    if (AstStatRepeat* stat = node->as<AstStatRepeat>())
+        return opensGotoLabel(stat->body);
+
+    if (AstStatFor* stat = node->as<AstStatFor>())
+        return opensGotoLabel(stat->body);
+
+    if (AstStatForIn* stat = node->as<AstStatForIn>())
+        return opensGotoLabel(stat->body);
+
+    return false;
+}
+
+static bool suffixOpensGotoLabel(AstStat** data, size_t begin, size_t size)
+{
+    for (size_t i = begin; i < size; ++i)
+        if (opensGotoLabel(data[i]))
+            return true;
+
+    return false;
+}
