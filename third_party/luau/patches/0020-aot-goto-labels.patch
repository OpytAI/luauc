+void BytecodeBuilder::patchCloseUpvals(size_t pc, uint8_t reg)
+{
+    LUAU_ASSERT(pc < insns.size());
+    LUAU_ASSERT(LUAU_INSN_OP(insns[pc]) == LOP_CLOSEUPVALS);
+    insns[pc] = uint32_t(LOP_CLOSEUPVALS) | (uint32_t(reg) << 8);
+}
+
+void BytecodeBuilder::neutralizeCloseUpvals(size_t pc)
+{
+    LUAU_ASSERT(pc < insns.size());
+    LUAU_ASSERT(LUAU_INSN_OP(insns[pc]) == LOP_CLOSEUPVALS);
+    insns[pc] = uint32_t(LOP_NOP);
+}
